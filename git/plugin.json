{
  "id": "git",
  "version": "0.1.10",
  "minCodeterm": "1.21.1",
  "hostApi": 2,
  "displayName": "Git",
  "description": "Live Git branch and working-tree status in the pane footer, a glance popover, and a full Git view. Reads each pane's repo with the local git binary.",
  "readme": "README.md",
  "icon": "icon.svg",
  "entry": "plugin.js",
  "capabilities": {
    "statusBubble": true,
    "glanceView": true,
    "view": true
  },
  "permissions": {
    "subprocess": {
      "allow": [
        "git"
      ]
    }
  },
  "hostIoJobs": true
}
