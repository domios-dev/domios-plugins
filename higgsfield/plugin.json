{
  "id": "higgsfield",
  "version": "0.1.1",
  "minCodeterm": "1.18.0",
  "hostApi": 2,
  "displayName": "Higgsfield",
  "description": "DEV 550cb1c only: protected SOUL2 quote/host approval/job runtime. Public released minimum unknown; HIG11 retained.",
  "entry": "plugin.js",
  "readme": "README.md",
  "icon": "icon.svg",
  "capabilities": {
    "view": true,
    "surfaces": [
      {
        "id": "studio",
        "title": "Higgsfield",
        "renderer": "view",
        "agentBound": true,
        "agentVerbs": [
          "open",
          "close",
          "catalog",
          "describe",
          "prepare",
          "rerun",
          "estimate",
          "usage",
          "history",
          "result",
          "cancel",
          "reconcile",
          "submit",
          "metadata",
          "status"
        ],
        "stateInvalidation": true,
        "restore": "relaunch"
      }
    ],
    "mediaDelivery": {
      "types": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "video/mp4",
        "video/webm",
        "audio/wav",
        "audio/mpeg",
        "audio/ogg"
      ]
    },
    "viewHostActions": [
      "copyText",
      "saveAs",
      "reveal"
    ],
    "agentCommands": true,
    "binaryTransfer": {
      "maxUploadBytes": 16384,
      "maxDownloadBytes": 8388608,
      "timeoutMs": 30000,
      "credentialOrigins": {
        "secret:higgsfield-api-key": [
          "https://api.higgsfield.ai"
        ]
      },
      "requestHeaders": [
        "Idempotency-Key"
      ]
    },
    "jobLifecycle": {
      "contractVersion": 1,
      "reconcile": true,
      "cancel": false
    }
  },
  "permissions": {
    "agentCommands": true,
    "surfaces": true,
    "secrets": true,
    "network": {
      "allow": [
        "api.higgsfield.ai"
      ]
    }
  },
  "agentGuide": "runtime-guide.md",
  "agentVerbs": [
    "status",
    "catalog",
    "describe --stdin (operation)",
    "prepare --stdin (prompt; optional aspect_ratio, seed)",
    "submit --stdin (id; host approval required)",
    "reconcile --stdin (id; free same-job lookup/output download)",
    "result --stdin (id; saved file/media)",
    "open",
    "close"
  ],
  "settingsSchema": "settings.schema.json",
  "configHelp": "DEV exact build 550cb1cbcbc34ab484a5f199c56d5b564661daba only. Provision declared higgsfield-api-key via plugin config --secret and stdin only. Never disclose key values. Host resolves credentials; JavaScript never reads them. Public release compatibility is unproved."
}
