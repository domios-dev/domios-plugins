{
  "id": "higgsfield",
  "version": "0.1.0",
  "minCodeterm": "1.17.1",
  "hostApi": 2,
  "displayName": "Higgsfield",
  "description": "DEV discovery and document history runtime. Paid generation unavailable; full SDK/minimum-host acceptance retained by HIG-11.",
  "entry": "plugin.js",
  "readme": "README.md",
  "icon": "icon.svg",
  "capabilities": {
    "view": true,
    "surfaces": [
      {
        "id": "studio",
        "title": "Higgsfield",
        "renderer": "view",
        "agentBound": true,
        "agentVerbs": [
          "open",
          "close",
          "catalog",
          "describe",
          "prepare",
          "rerun",
          "estimate",
          "usage",
          "history",
          "result",
          "cancel",
          "reconcile",
          "submit",
          "metadata",
          "status"
        ],
        "stateInvalidation": true,
        "restore": "relaunch"
      }
    ],
    "mediaDelivery": {
      "types": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "video/mp4",
        "video/webm",
        "audio/wav",
        "audio/mpeg",
        "audio/ogg"
      ]
    },
    "viewHostActions": [
      "copyText",
      "saveAs",
      "reveal"
    ],
    "agentCommands": true
  },
  "permissions": {
    "agentCommands": true,
    "surfaces": true
  },
  "agentGuide": "runtime-guide.md",
  "agentVerbs": [
    "status",
    "catalog",
    "describe --stdin (JSON: operation)",
    "open",
    "close",
    "prepare (unavailable)",
    "estimate (unavailable)",
    "submit (unavailable)",
    "result (unavailable)"
  ]
}
