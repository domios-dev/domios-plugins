{
  "id": "elevenlabs",
  "version": "0.1.0",
  "hostApi": 2,
  "displayName": "ElevenLabs",
  "description": "DEV 550cb1c only: protected free account/voice/model discovery. TTS refuses until safe account pricing is established; HIG11 retained.",
  "entry": "plugin.js",
  "readme": "AGENTS.md",
  "capabilities": {
    "view": true,
    "transcriber": true,
    "agentCommands": true,
    "surfaces": [
      {
        "id": "studio",
        "title": "ElevenLabs",
        "renderer": "view",
        "agentBound": true,
        "agentVerbs": [
          "help",
          "open",
          "close",
          "status",
          "activity",
          "catalog",
          "capabilities",
          "models",
          "describe",
          "estimate",
          "usage",
          "history",
          "result",
          "cancel",
          "reconcile",
          "prepare",
          "rerun",
          "generate",
          "inspect",
          "read",
          "voices",
          "live-models",
          "account"
        ],
        "stateInvalidation": true,
        "restore": "none"
      }
    ],
    "binaryTransfer": {
      "maxUploadBytes": 16384,
      "maxDownloadBytes": 8388608,
      "timeoutMs": 30000,
      "credentialOrigins": {
        "secret:elevenlabs-api-key": [
          "https://api.elevenlabs.io"
        ]
      },
      "requestHeaders": []
    },
    "jobLifecycle": {
      "contractVersion": 1,
      "reconcile": true,
      "cancel": false
    }
  },
  "permissions": {
    "surfaces": true,
    "agentCommands": true,
    "secrets": true,
    "network": {
      "allow": [
        "api.elevenlabs.io"
      ]
    }
  },
  "minCodeterm": "1.17.1",
  "agentGuide": "runtime-guide.md",
  "agentVerbs": [
    "status",
    "catalog",
    "describe --stdin (operation)",
    "voices (free read only, first20)",
    "live-models (free account model/rate metadata)",
    "account (free quota/policy metadata)",
    "prepare --stdin (voice,text,model optional; safe-pricing requirement)",
    "generate (unavailable until safe pricing)",
    "open",
    "close"
  ],
  "settingsSchema": "settings.schema.json",
  "configHelp": "DEV exact build 550cb1cbcbc34ab484a5f199c56d5b564661daba only. Provision declared elevenlabs-api-key via plugin config --secret and stdin only. Never disclose key values. Host resolves credentials; JavaScript never reads them. Public release compatibility is unproved."
}
